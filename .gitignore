# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by `expo prebuild`.
# Anchored with a leading slash so only the project-root folders are ignored.
# Unanchored "android/" would also hide modules/termux-integration/android/.
/android
/ios

# Environment and secrets
.env
.env*.local

# Signing keys and certificates
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Logs and temp files
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*
*.log
.DS_Store
*.tsbuildinfo
